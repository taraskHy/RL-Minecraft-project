{
  "schema": 1,
  "name": "iq-experiment",
  "description": "Declared in configs/initial_q_experiment.json: unmasked Q-learning and SARSA from initial Q 0 and -1, three agent seeds each, 50 live training episodes on worlds 100-149, then every frozen policy and the uniform random baseline on held-out worlds 40000-40019. Jobs are listed in pairs (the two initial values of one algorithm and agent seed) so that the arms share the load evenly. iq-filler-random (worlds 40100-40119) only keeps the second slot busy at the end and is never analysed.",
  "slots": 2,
  "interleave": true,
  "evaluate_after_all_training": true,
  "defaults": {"agent_seed": 0, "max_steps": 60, "pause": 0},
  "jobs": [
    {"name": "iq-q-zero-s0-train", "kind": "train", "condition": "unmasked", "algorithm": "q_learning", "episodes": 50, "first_world_seed": 100, "epsilon": 0.6, "epsilon_end": 0.1, "agent_seed": 0, "initial_q": 0.0},
    {"name": "iq-q-pess-s0-train", "kind": "train", "condition": "unmasked", "algorithm": "q_learning", "episodes": 50, "first_world_seed": 100, "epsilon": 0.6, "epsilon_end": 0.1, "agent_seed": 0, "initial_q": -1.0},
    {"name": "iq-q-zero-s1-train", "kind": "train", "condition": "unmasked", "algorithm": "q_learning", "episodes": 50, "first_world_seed": 100, "epsilon": 0.6, "epsilon_end": 0.1, "agent_seed": 1, "initial_q": 0.0},
    {"name": "iq-q-pess-s1-train", "kind": "train", "condition": "unmasked", "algorithm": "q_learning", "episodes": 50, "first_world_seed": 100, "epsilon": 0.6, "epsilon_end": 0.1, "agent_seed": 1, "initial_q": -1.0},
    {"name": "iq-q-zero-s2-train", "kind": "train", "condition": "unmasked", "algorithm": "q_learning", "episodes": 50, "first_world_seed": 100, "epsilon": 0.6, "epsilon_end": 0.1, "agent_seed": 2, "initial_q": 0.0},
    {"name": "iq-q-pess-s2-train", "kind": "train", "condition": "unmasked", "algorithm": "q_learning", "episodes": 50, "first_world_seed": 100, "epsilon": 0.6, "epsilon_end": 0.1, "agent_seed": 2, "initial_q": -1.0},
    {"name": "iq-sarsa-zero-s0-train", "kind": "train", "condition": "unmasked", "algorithm": "sarsa", "episodes": 50, "first_world_seed": 100, "epsilon": 0.6, "epsilon_end": 0.1, "agent_seed": 0, "initial_q": 0.0},
    {"name": "iq-sarsa-pess-s0-train", "kind": "train", "condition": "unmasked", "algorithm": "sarsa", "episodes": 50, "first_world_seed": 100, "epsilon": 0.6, "epsilon_end": 0.1, "agent_seed": 0, "initial_q": -1.0},
    {"name": "iq-sarsa-zero-s1-train", "kind": "train", "condition": "unmasked", "algorithm": "sarsa", "episodes": 50, "first_world_seed": 100, "epsilon": 0.6, "epsilon_end": 0.1, "agent_seed": 1, "initial_q": 0.0},
    {"name": "iq-sarsa-pess-s1-train", "kind": "train", "condition": "unmasked", "algorithm": "sarsa", "episodes": 50, "first_world_seed": 100, "epsilon": 0.6, "epsilon_end": 0.1, "agent_seed": 1, "initial_q": -1.0},
    {"name": "iq-sarsa-zero-s2-train", "kind": "train", "condition": "unmasked", "algorithm": "sarsa", "episodes": 50, "first_world_seed": 100, "epsilon": 0.6, "epsilon_end": 0.1, "agent_seed": 2, "initial_q": 0.0},
    {"name": "iq-sarsa-pess-s2-train", "kind": "train", "condition": "unmasked", "algorithm": "sarsa", "episodes": 50, "first_world_seed": 100, "epsilon": 0.6, "epsilon_end": 0.1, "agent_seed": 2, "initial_q": -1.0},
    {"name": "iq-q-zero-s0-test", "kind": "evaluate", "policy_from": "iq-q-zero-s0-train", "episodes": 20, "first_world_seed": 40000},
    {"name": "iq-q-pess-s0-test", "kind": "evaluate", "policy_from": "iq-q-pess-s0-train", "episodes": 20, "first_world_seed": 40000},
    {"name": "iq-q-zero-s1-test", "kind": "evaluate", "policy_from": "iq-q-zero-s1-train", "episodes": 20, "first_world_seed": 40000},
    {"name": "iq-q-pess-s1-test", "kind": "evaluate", "policy_from": "iq-q-pess-s1-train", "episodes": 20, "first_world_seed": 40000},
    {"name": "iq-q-zero-s2-test", "kind": "evaluate", "policy_from": "iq-q-zero-s2-train", "episodes": 20, "first_world_seed": 40000},
    {"name": "iq-q-pess-s2-test", "kind": "evaluate", "policy_from": "iq-q-pess-s2-train", "episodes": 20, "first_world_seed": 40000},
    {"name": "iq-sarsa-zero-s0-test", "kind": "evaluate", "policy_from": "iq-sarsa-zero-s0-train", "episodes": 20, "first_world_seed": 40000},
    {"name": "iq-sarsa-pess-s0-test", "kind": "evaluate", "policy_from": "iq-sarsa-pess-s0-train", "episodes": 20, "first_world_seed": 40000},
    {"name": "iq-sarsa-zero-s1-test", "kind": "evaluate", "policy_from": "iq-sarsa-zero-s1-train", "episodes": 20, "first_world_seed": 40000},
    {"name": "iq-sarsa-pess-s1-test", "kind": "evaluate", "policy_from": "iq-sarsa-pess-s1-train", "episodes": 20, "first_world_seed": 40000},
    {"name": "iq-sarsa-zero-s2-test", "kind": "evaluate", "policy_from": "iq-sarsa-zero-s2-train", "episodes": 20, "first_world_seed": 40000},
    {"name": "iq-sarsa-pess-s2-test", "kind": "evaluate", "policy_from": "iq-sarsa-pess-s2-train", "episodes": 20, "first_world_seed": 40000},
    {"name": "iq-random-test", "kind": "evaluate", "random_baseline": true, "condition": "unmasked", "episodes": 20, "first_world_seed": 40000},
    {"name": "iq-filler-random", "kind": "evaluate", "random_baseline": true, "condition": "unmasked", "episodes": 20, "first_world_seed": 40100}
  ]
}
